<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="k1" author="suite">
        <createTable tableName="dept">
            <column name="id" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(40)">
                <constraints unique="true" nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="k2" author="suite">
        <createTable tableName="emp">
            <column name="id" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="dept_id" type="INT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="emp" baseColumnNames="dept_id"
                                 constraintName="fk_emp_dept"
                                 referencedTableName="dept" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
